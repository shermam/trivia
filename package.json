{
  "name": "trivia-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "firebase:emulate": "npm run build:prod && firebase emulators:start",
    "firebase:deploy": "npm run build:prod && firebase deploy --only hosting,firestore",
    "e2e:serve": "ng serve --configuration=e2e",
    "e2e:runner": "start-server-and-test e2e:serve http://localhost:4200 cypress:run",
    "e2e:runner:open": "start-server-and-test e2e:serve http://localhost:4200 cypress:open",
    "e2e": "npx firebase-tools@13 emulators:exec --project demo-trivia-app-e2e --only auth,firestore \"npm run e2e:runner\"",
    "e2e:open": "npx firebase-tools@13 emulators:exec --project demo-trivia-app-e2e --only auth,firestore \"npm run e2e:runner:open\"",
    "cypress:open": "ELECTRON_RUN_AS_NODE= cypress open",
    "cypress:run": "ELECTRON_RUN_AS_NODE= cypress run"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "firebase": "^12.16.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.8",
    "@angular/cli": "^22.0.8",
    "@angular/compiler-cli": "^22.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "cypress": "^15.19.0",
    "firebase-admin": "^14.2.0",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.23",
    "prettier": "^3.8.1",
    "start-server-and-test": "^3.0.11",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
