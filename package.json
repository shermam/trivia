{
  "name": "trivia-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "postinstall": "npm run functions:install",
    "functions:install": "npm --prefix functions ci",
    "functions:install:update": "npm --prefix functions install",
    "functions:build": "npm --prefix functions run build",
    "functions:test": "npm --prefix functions test",
    "rules:test:runner": "vitest run --config vitest.rules.config.ts",
    "rules:test": "firebase emulators:exec --project demo-trivia-rules --only firestore \"npm run rules:test:runner\"",
    "firebase:emulate": "npm run build:prod && npm run functions:build && firebase emulators:start",
    "firebase:deploy": "npm run build:prod && firebase deploy --only hosting,firestore,functions",
    "e2e:serve": "ng serve --configuration=e2e",
    "e2e:runner": "start-server-and-test e2e:serve http://localhost:4200 cypress:run",
    "e2e:runner:open": "start-server-and-test e2e:serve http://localhost:4200 cypress:open",
    "e2e": "npm run functions:build && firebase emulators:exec --project demo-trivia-app-e2e --only auth,firestore,functions \"npm run e2e:runner\"",
    "e2e:open": "npm run functions:build && firebase emulators:exec --project demo-trivia-app-e2e --only auth,firestore,functions \"npm run e2e:runner:open\"",
    "e2e:preview": "ELECTRON_RUN_AS_NODE= cypress run --config-file cypress.preview.config.ts",
    "cypress:open": "ELECTRON_RUN_AS_NODE= cypress open",
    "cypress:run": "ELECTRON_RUN_AS_NODE= cypress run",
    "build:lighthouse": "ng build --configuration=lighthouse",
    "lighthouse:runner": "lhci autorun --config=./lighthouserc.json",
    "lighthouse": "npm run build:lighthouse && npm run lighthouse:config && npx --yes firebase-tools@13 emulators:exec --config firebase.lighthouse.json --project demo-trivia-app-e2e --only hosting,auth,firestore \"npm run lighthouse:runner\"",
    "lint": "ng lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lighthouse:config": "node scripts/make-lighthouse-firebase-config.mjs"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@angular/service-worker": "^22.0.8",
    "firebase": "^12.16.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.8",
    "@angular/cli": "^22.0.8",
    "@angular/compiler-cli": "^22.0.0",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "5.0.1",
    "@lhci/cli": "^0.15.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@vitest/coverage-v8": "^4.1.10",
    "angular-eslint": "22.1.0",
    "cypress": "^15.19.0",
    "eslint": "^10.6.0",
    "fake-indexeddb": "^6.2.5",
    "firebase-admin": "^14.2.0",
    "firebase-tools": "^15.26.0",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.23",
    "prettier": "^3.8.1",
    "start-server-and-test": "^3.0.11",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.62.1",
    "vitest": "^4.0.8"
  }
}
