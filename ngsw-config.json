{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "deferred-routes",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/add-question.component-*.js",
          "/markdown-engine-*.js",
          "/math-engine-*.js",
          "/my-questions.component-*.js",
          "/pricing.component-*.js",
          "/privacy-policy.component-*.js",
          "/profile-stats.component-*.js",
          "/review-queue.component-*.js",
          "/terms-of-service.component-*.js"
        ]
      }
    },
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.csr.html",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"]
      }
    }
  ]
}
