rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Signed in, not anonymous, and (for password accounts) email-verified —
    // so spinning up throwaway/alias accounts can't be used to flood the
    // leaderboard.
    function isRealAuthedUser() {
      return request.auth != null
             && request.auth.token.firebase.sign_in_provider != 'anonymous'
             && (request.auth.token.firebase.sign_in_provider != 'password'
                 || request.auth.token.email_verified == true);
    }

    function isValidLeaderboardEntry(uid) {
      return request.resource.data.keys().hasOnly(
                ['uid', 'name', 'score', 'totalQuestions', 'percentage', 'createdAt']
              )
            && request.resource.data.uid == uid
            && request.resource.data.name is string
            && request.resource.data.name.size() > 0
            && request.resource.data.name.size() <= 30
            && request.resource.data.score is int
            && request.resource.data.score >= 0
            && request.resource.data.totalQuestions is int
            && request.resource.data.totalQuestions >= request.resource.data.score
            && request.resource.data.percentage is number
            && request.resource.data.percentage >= 0
            && request.resource.data.percentage <= 100
            && request.resource.data.createdAt is int;
    }

    function isValidCustomQuestion() {
      let data = request.resource.data;
      return data.keys().hasOnly(
                ['category', 'type', 'difficulty', 'question', 'correct_answer', 'incorrect_answers']
              )
            && data.category is string && data.category.size() > 0 && data.category.size() <= 100
            && data.type in ['multiple', 'boolean']
            && data.difficulty in ['easy', 'medium', 'hard']
            && data.question is string && data.question.size() > 0 && data.question.size() <= 500
            && data.correct_answer is string
            && data.correct_answer.size() > 0 && data.correct_answer.size() <= 200
            && data.incorrect_answers is list
            && data.incorrect_answers.size() >= 1 && data.incorrect_answers.size() <= 5;
    }

    // Question bank: readable by anyone playing the game. Creating a new
    // question is open to any real (non-anonymous, verified-if-password)
    // account — same anti-flood gate as the leaderboard — subject to schema
    // validation above; editing/removing an existing one is console-only.
    match /custom_questions/{questionId} {
      allow read: if true;
      allow create: if isRealAuthedUser() && isValidCustomQuestion();
      allow update, delete: if false;
    }

    // Leaderboard: readable by anyone; one document per user (doc ID == uid),
    // append-only in the sense that a write only succeeds if it beats that
    // user's existing best score.
    match /leaderboard/{uid} {
      allow read: if true;
      allow create: if isRealAuthedUser()
                    && request.auth.uid == uid
                    && isValidLeaderboardEntry(uid);
      allow update: if isRealAuthedUser()
                    && request.auth.uid == uid
                    && isValidLeaderboardEntry(uid)
                    && request.resource.data.score > resource.data.score;
      allow delete: if false;
    }
  }
}
