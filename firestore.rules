rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Signed in, not anonymous, and (for password accounts) email-verified —
    // so spinning up throwaway/alias accounts can't be used to flood the
    // leaderboard.
    function isRealAuthedUser() {
      return request.auth != null
             && request.auth.token.firebase.sign_in_provider != 'anonymous'
             && (request.auth.token.firebase.sign_in_provider != 'password'
                 || request.auth.token.email_verified == true);
    }

    // Set by our Stripe webhook handler (functions/src/subscriptions.ts) as
    // a custom claim on the user's ID token once a subscription with a
    // price tagged `firebaseRole: 'pro'` (see the Stripe Dashboard setup)
    // reaches `active`/`trialing`. This is what actually gates the write
    // below — the client's real-time `SubscriptionService.isProUser` signal
    // is read-your-own-writes UX only and carries no authority here.
    function isProUser() {
      return request.auth != null && request.auth.token.stripeRole == 'pro';
    }

    // Whether the caller holds the moderation role, read from the `user_roles`
    // register below. A document rather than a custom claim so that revoking it
    // takes effect on the very next request — the full reasoning, and the four
    // emulator probes the design rests on, are on the `user_roles` match block.
    //
    // Always write this as the *right* operand of `||`. The language
    // short-circuits, so `<public condition> || isReviewer()` costs nothing for
    // the callers who satisfy the public condition, and one billed document
    // read for the reviewers who do not. Leading with it would bill every
    // player on every request for a lookup that almost always returns nothing.
    //
    // A caller with no role document denies rather than erroring open — probed,
    // not assumed, and pinned by a test.
    function isReviewer() {
      return request.auth != null
             && get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.reviewer == true;
    }

    // Bounds on a client-supplied epoch-ms timestamp: it must sit close to
    // when the server actually saw the request. Generous on the past side for
    // a slow connection or a clock a few minutes behind, tight on the future
    // side. Without this, `createdAt` is decoration — a client can write any
    // number it likes, including one chosen to sort itself first.
    function isNearRequestTime(millis) {
      return millis is int
             && millis <= request.time.toMillis() + 60000
             && millis >= request.time.toMillis() - 300000;
    }

    // The longest game the app can produce. GameSetupComponent offers
    // 5/10/15/20/25 questions, so 25 is the ceiling a real game can reach.
    //
    // Deliberately NOT restricted to that exact set: a `custom` or `mixed`
    // game legitimately returns *fewer* questions than requested when the
    // bank doesn't have enough (TriviaService slices over whatever matched),
    // so asking for 25 when 7 exist produces a genuine 7-question game.
    // Allowing 1..25 accepts every real game and nothing longer.
    //
    // Raising the option list above 25 means raising this too — the rules
    // tests will fail loudly if the two ever disagree, which is the point.
    // Enforced by isValidBoardEntry below; the flat collection's own
    // validator went away with its write rules when G7 retired it.

    // The timing constraints a game can be played under, and therefore the
    // set of leaderboards that exist (finding G7). A score won with no time
    // limit is not comparable to one won in 15 seconds, so each constraint
    // gets its own board rather than one board recording the conditions.
    //
    // This list is the schema. Adding an option to GameSetupComponent without
    // adding it here produces a game whose score can never be saved, and the
    // rules tests enumerate the same three values so the two cannot silently
    // drift.
    function isValidBoard(limit) {
      return limit in ['15', '30', 'unlimited'];
    }

    // Everything a leaderboard entry must be, plus the board it is being
    // written to. `timeLimit` is redundant with the path and is required anyway: an
    // exact-key hasOnly() allowlist cannot be widened after the fact without
    // rejecting every existing document (the A10 wall), and an export or an
    // admin listing across boards should not have to parse document paths to
    // know what it is looking at. Requiring it to equal the path segment is
    // what keeps the redundancy honest.
    function isValidBoardEntry(uid, limit) {
      let data = request.resource.data;
      return data.keys().hasOnly(
                ['uid', 'name', 'score', 'totalQuestions', 'percentage', 'createdAt', 'timeLimit']
              )
            && data.timeLimit == limit
            && data.uid == uid
            && data.name is string
            && data.name.size() > 0
            && data.name.size() <= 30
            && data.score is int
            && data.score >= 0
            && data.totalQuestions is int
            && data.totalQuestions >= 1
            && data.totalQuestions <= 25
            && data.totalQuestions >= data.score
            && data.percentage is int
            && data.percentage == math.round(data.score * 100.0 / data.totalQuestions)
            && isNearRequestTime(data.createdAt);
    }

    // A bare `scheme://host[:port]` — no path, no query, no fragment, so
    // there is nothing to smuggle into the redirect URL the Cloud Function
    // builds from it. Which origins are actually *ours* deliberately isn't
    // decided here: preview channels mint a new hostname per PR, and this
    // same file runs against the emulator on localhost, so the rules can only
    // bound the shape. The allowlist proper is in the function
    // (functions/src/checkout-request.ts) — this is the structural half of
    // the two-layer check, not the whole of it.
    function isAppOrigin(origin) {
      return origin is string
            && origin.size() <= 200
            && origin.matches(
                 '^https://[a-z0-9-]+([.][a-z0-9-]+)+(:[0-9]{1,5})?$'
                 + '|^http://(localhost|127[.]0[.]0[.]1)(:[0-9]{1,5})?$'
               );
    }

    // The only two things a checkout-session document may carry. Everything
    // else the Stripe call needs — the mode, and both redirect URLs — is
    // decided by `createCheckoutSession` itself, so there is no longer a
    // client-chosen value for it to hand to Stripe. `price` is bounded to the
    // shape of a Stripe price ID here; whether that ID is one we actually
    // sell is checked again in the function, against the mirrored catalog,
    // because rules cannot look a value up in a catalog.
    function isValidCheckoutSession() {
      let data = request.resource.data;
      return data.keys().hasOnly(['price', 'origin'])
            && data.price is string
            && data.price.matches('^price_[A-Za-z0-9_]{1,100}$')
            && isAppOrigin(data.origin);
    }

    function isValidPortalSession() {
      let data = request.resource.data;
      return data.keys().hasOnly(['origin'])
            && isAppOrigin(data.origin);
    }

    // The window a session document ID is bucketed into, as a string.
    // 300000ms = 5 minutes, chosen to match the past-side tolerance of
    // `isNearRequestTime()` above — that is the client-clock skew this app
    // has already decided to live with, and a client has to derive the same
    // bucket from its own clock to write one of these.
    //
    // Plain `/` and not `math.floor()`: dividing two ints in this language
    // already truncates (and epoch millis are always positive, so truncation
    // and floor agree), whereas `math.floor()` returns a *float*, which
    // `string()` then renders as "5954006.0" and no client would ever match.
    // Verified against the emulator rather than assumed, the same way
    // `math.round()` was checked before the leaderboard relied on it.
    function sessionWindow(offsetMillis) {
      return string((request.time.toMillis() + offsetMillis) / 300000);
    }

    // The volume cap. Rules cannot count a user's documents, but they can
    // constrain the document ID, and `create` only ever applies to an ID that
    // doesn't exist yet — so restricting the ID to `{window}-{slot 0-9}`
    // means each of those ten IDs can be used exactly once per window. That
    // is ten Cloud Function invocations, and therefore ten Stripe API calls,
    // per five minutes per user; without it a loop of `addDoc` calls spends
    // the Functions quota and the Stripe rate limit as fast as it can write.
    //
    // The neighbouring windows are accepted too, so a clock a few minutes off
    // — or a write that simply crosses a boundary between the client picking
    // an ID and the server evaluating it — isn't rejected. That widens a
    // burst to thirty, but the steady-state rate is still ten per window.
    function isRateLimitedSessionId(sessionId) {
      return sessionId.matches(
        '^(' + sessionWindow(-300000)
        + '|' + sessionWindow(0)
        + '|' + sessionWindow(300000) + ')-[0-9]$'
      );
    }

    // The hourly bucket a question submission counts against, as a string, for
    // the `custom_question_quota` document ID.
    //
    // Integer division, deliberately, and NOT `math.floor()`. `math.floor()`
    // returns a float, so `string(math.floor(x))` renders "5954006.0" — which
    // is how the session-document cap came to reject every legitimate checkout
    // while a suite of nothing but `assertFails` passed. Probed against the
    // emulator before this was written: `string(millis / 3600000)` renders a
    // plain integer, and the ".0" form is rejected. Both directions are pinned
    // in `firestore-tests/custom-questions.rules.spec.ts`.
    function questionQuotaWindow() {
      return string(request.time.toMillis() / 3600000);
    }

    function questionQuotaPath() {
      return /databases/$(database)/documents/custom_question_quota/$(questionQuotaWindow() + '-' + request.auth.uid);
    }

    // How many questions one account may publish per hour.
    //
    // Rules cannot count a user's documents, so the count lives in a document
    // the client has to write in the *same batch* — `getAfter()` reads its
    // post-commit state, which is what makes declining to increment it
    // impossible rather than merely discouraged. The document ID carries the
    // window and the uid, so a new hour is simply a new document and there is
    // no rollover arithmetic to get wrong, and the path is derived here from
    // `request.auth.uid` rather than from anything the client sends — batching
    // against somebody else's counter does not typecheck.
    function withinQuestionQuota() {
      return existsAfter(questionQuotaPath())
             && getAfter(questionQuotaPath()).data.count <= maxQuestionsPerWindow();
    }

    function maxQuestionsPerWindow() {
      return 20;
    }

    // The moderation status a newly submitted question is created with, and
    // the only value `create` accepts.
    //
    // `'pending'` as of item 4c: a submission is stored but not served until a
    // reviewer approves it. The published policy text changed in the same PR,
    // because "submissions are published immediately, without review" was the
    // sentence this falsified (`CLAUDE.md` §4.0).
    //
    // Still named rather than inlined. Keeping it as one function is what let
    // the flip be a single line here and a single line in
    // `firebase.service.ts`, and what let the rules tests pin *both* halves —
    // the accept case for the current value and the reject case for the
    // others — so the change showed up as ten failing tests rather than as a
    // silent widening.
    function statusOnSubmission() {
      return 'pending';
    }

    function isValidCustomQuestion() {
      let data = request.resource.data;
      return data.keys().hasOnly(
                ['category', 'type', 'difficulty', 'question', 'correct_answer',
                 'incorrect_answers', 'createdBy', 'createdAt', 'status']
              )
            && data.category is string && data.category.size() > 0 && data.category.size() <= 100
            && data.type in ['multiple', 'boolean']
            && data.difficulty in ['easy', 'medium', 'hard']
            && data.question is string && data.question.size() > 0 && data.question.size() <= 500
            && data.correct_answer is string
            && data.correct_answer.size() > 0 && data.correct_answer.size() <= 200
            && data.incorrect_answers is list
            // 3, not 5: AddQuestionComponent offers exactly three incorrect
            // fields for a multiple-choice question and derives one for a
            // boolean, so 1..3 is every question the app can actually produce.
            // The old ceiling of 5 allowed six answers in total while the quiz
            // only ever labelled four (finding B2).
            && data.incorrect_answers.size() >= 1 && data.incorrect_answers.size() <= 3
            // An answer that is both correct and incorrect is not a question,
            // it is a scoring bug waiting to happen: the quiz used to match a
            // click against `correct_answer` by text, so the wrong option
            // scored as correct (finding B1). The client no longer compares by
            // text, but the data should never have contained the ambiguity in
            // the first place — fixing only the reader would leave the next
            // reader to rediscover it.
            && !(data.correct_answer in data.incorrect_answers)
            && data.incorrect_answers.toSet().size() == data.incorrect_answers.size()
            // Attribution is mandatory and self-asserting only: a submitter
            // can name themselves and nobody else. This is what makes an abuse
            // report actionable, and what lets account deletion find a user's
            // contributions — neither is retrofittable, because no backfill
            // can invent an author for a document that never recorded one.
            && data.createdBy is string && data.createdBy == request.auth.uid
            && isNearRequestTime(data.createdAt)
            // Mandatory, not optional-if-present. An optional field would let
            // a client cached from before this change keep writing documents
            // with no status at all, which the backfill has already run past —
            // so the collection would drift back out of the invariant it was
            // just migrated into, silently, and the read filter in 4b-ii would
            // stop serving those questions. Requiring it costs exactly one
            // refused submission per stale client, surfaced by the form's
            // existing error path and fixed by a reload. Same trade as the
            // checkout-session schema change and the leaderboard retirement
            // (`data-model.md` §3).
            && data.status == statusOnSubmission();
    }

    // Moderation roles, granted by hand. Empty today: nothing reads it yet
    // (`BACKLOG.md` item 4a), and the rules that will are deliberately not in
    // this PR, because a rules helper no rule calls cannot be mutation-tested
    // and an untestable security helper is worse than a later one.
    //
    // **A document rather than a custom claim**, for two reasons that point the
    // same way. The Firebase console cannot set custom claims at all — there is
    // no claims editor on the Authentication page, and no gcloud equivalent —
    // so a claim would mean running an Admin SDK script for every promotion,
    // rather than the by-hand console edit this was specified to be. And a
    // claim revokes
    // *slowly*: unsetting one only changes what the **next** ID token says, so
    // a removed reviewer keeps the privilege until the token already in their
    // browser expires, up to an hour (`CLAUDE.md` §4.2). That window was
    // accepted for `stripeRole` on the explicit grounds that it gates nothing
    // more valuable than adding a question to a shared bank (A13); approving
    // *other people's* questions into that bank is more valuable than that, so
    // the acceptance does not carry over. A rule that reads a document is
    // evaluated at request time — delete the document and the very next
    // request is refused, with no token refresh and no sign-out.
    //
    // The cost is one billed read, and only on operations a reviewer actually
    // performs: `||` short-circuits, so a rule written as
    // `<public condition> || isReviewer()` never evaluates the lookup for the
    // players who satisfy the public condition. Probed against the emulator
    // rather than assumed, along with the three other behaviours this design
    // rests on — a missing role document denies rather than erroring open,
    // `get()` is usable inside a `list` rule, and a role document that exists
    // with `reviewer: false` denies exactly like one that is absent.
    //
    // One document per user carrying flags, not a `reviewers/{uid}`
    // collection: a single read serves any number of role checks, and an
    // `admin` flag is already foreseen. Nothing here is client-writable, so
    // there is no exact-key `hasOnly()` allowlist and therefore none of the
    // A10 one-way door — fields can be added later at no cost, which is the
    // exact inverse of `custom_questions` and worth knowing before treating
    // this schema as fixed.
    match /user_roles/{uid} {
      // Your own document, and only ever as a single-document `get`. This is
      // what lets the UI offer a reviewer a way in without guessing: it reads
      // the same document and the same field the privileged rules will read,
      // so the client signal cannot drift *broader* than the server gate the
      // way `isProUser` did (H6). It is not a mirror of the predicate, it is
      // the predicate.
      //
      // `request.auth != null` and not `isRealAuthedUser()`: an anonymous
      // session gets a fresh uid it does not choose, so it can never name a
      // document somebody was granted a role on, and the read returns nothing.
      // Narrowing it would add a second condition that has to stay in step
      // with nothing.
      allow get: if request.auth != null && request.auth.uid == uid;

      // Never enumerable, by anyone — including a reviewer. Who moderates is
      // not public, and a list of moderators is a list of accounts worth
      // attacking. Spelled out rather than left to default-deny because the
      // obvious `allow read` would have granted both verbs, and the difference
      // between them is the entire point of this rule.
      allow list: if false;

      // Assignment is out of band: the console and the Admin SDK bypass these
      // rules, and no client path exists at all. That is why there is no
      // `admin` role yet — with nothing for one to guard there is no
      // bootstrapping problem to solve and no self-escalation path to close.
      // Adding in-app role management is what creates the need for one, and it
      // is queued as such in `BACKLOG.md`.
      allow create, update, delete: if false;
    }

    // One document per player holding their lifetime gameplay totals. Created
    // lazily by the `recordGameResult` callable (`functions/src/game-stats.ts`)
    // the first time a signed-in account finishes a game, and deleted by
    // `deleteAccount`. Both go through the Admin SDK, which bypasses these
    // rules entirely.
    //
    // **Nothing here is client-writable, and that is the design rather than an
    // omission.** §4.1 of `CLAUDE.md` requires every client-writable collection
    // to carry an exact-key `hasOnly()` allowlist; §4.2 records the corollary,
    // that a document has no allowlist to widen later *only* while it stays
    // free of any client write path. Five roadmap specs name this document and
    // their proposed field sets are neither settled nor consistent with each
    // other, so freezing a key set here would put the A10 one-way door on the
    // collection least able to afford it. Keeping every write on the Admin SDK
    // costs one callable invocation per completed game and buys a schema that
    // can grow — the exact inverse of `custom_questions`, and the same bargain
    // `user_roles` above already makes.
    //
    // **The totals are not server-attested, and this is where that is written
    // down.** §4.1 wants an achievement number attested or hard-bounded; the
    // callable's payload is still client-supplied, so these are *bounded*
    // rather than attested — 1..25 questions per game, correct <= answered,
    // streak <= correct, one write per game id, and a per-hour ceiling. That is
    // audit decision A1 adopted deliberately rather than inherited by accident.
    // Reopening it means building the signed game token A1 deferred, not
    // loosening anything here.
    //
    // **Not created for anonymous sessions.** `deleteAccount` never runs for an
    // anonymous account, and Firebase's auto-deletion removes the Auth record
    // only — so a document per guest would accumulate with nothing able to
    // delete it, and the Privacy Policy's claim that no data of any kind is
    // attached to an anonymous session would stop being true on the first page
    // load after deploy. That gate lives in the callable, because there is no
    // client write rule here for it to live in.
    match /users/{uid} {
      // Your own totals, and only ever as a single-document `get`.
      //
      // `request.auth != null` rather than `isRealAuthedUser()`, following
      // `user_roles` above: an anonymous session gets a uid it does not choose,
      // so it can never name somebody else's document, and its own does not
      // exist. Narrowing it would add a second condition that has to stay in
      // step with nothing.
      allow get: if request.auth != null && request.auth.uid == uid;

      // Never enumerable, by anyone. Listing this collection is a roster of
      // every account that has ever finished a game, orderable by any field on
      // it. Spelled out rather than left to `allow read`, which would have
      // granted both verbs — and the difference between them is only
      // observable through a query Firestore can prove it satisfies, so the
      // tests pin `where(documentId(), '==', <own uid>)` specifically and that
      // one row is the entire content of this line.
      allow list: if false;

      // No client write path at all — see the block comment. This is the line
      // that keeps the schema growable, so changing it is not a rules tweak: it
      // is a decision to close the door, and it needs §4.1's full kit (exact-key
      // allowlist, type-and-range check per field, ownership check) plus a
      // re-argument of everything above, in the same PR.
      allow create, update, delete: if false;
    }

    // Question bank: readable by anyone playing the game. Creating a new
    // question requires both the anti-flood gate (real, non-anonymous,
    // verified-if-password account) and an active Pro subscription — this
    // is a paid-tier feature, see PricingComponent/AddQuestionComponent —
    // subject to schema validation above; editing/removing an existing one
    // is console-only.
    match /custom_questions/{questionId} {
      // Approved questions are public; anything else is reviewers only.
      //
      // **Rules are not filters**, so this does not quietly hide unapproved
      // questions from an unfiltered query — it *refuses* the query outright.
      // Every client read must therefore carry `where('status','==','approved')`,
      // which `getCustomQuestions` has sent since 4b-ii, one release before
      // this rule started requiring it. That ordering was the point: a browser
      // cached from before 4b-ii is refused here, so deferring the tightening
      // by a release means only a client stale by *two* releases breaks rather
      // than every client at once. `TriviaService` falls back to the offline
      // pool when the fetch throws, so even that client degrades to cached
      // questions rather than to nothing.
      //
      // `||` and not `&&`, and in this order: the language short-circuits, so
      // a player reading an approved question never triggers the `user_roles`
      // lookup. Only a read of something unapproved pays for it.
      //
      // A document with no `status` at all is refused by this rule (the field
      // access errors, which denies). That is correct and no longer reachable:
      // `scripts/backfill-question-status.mjs` stamped every document that
      // predated the field, and `isValidCustomQuestion()` has required it on
      // create since 4b-i, so there is no window in which one could exist.
      allow read: if resource.data.status == 'approved' || isReviewer();

      allow create: if isRealAuthedUser()
                    && isProUser()
                    && isValidCustomQuestion()
                    && withinQuestionQuota();

      // Moderation: a reviewer may move a question between statuses and may
      // change nothing else about it.
      //
      // `affectedKeys().hasOnly(['status'])` is what makes that true, and it is
      // doing more work than it looks. It stops a reviewer editing the question
      // text (that is item 6's job, for the author, and a moderator quietly
      // rewriting somebody's submission is a different feature nobody asked
      // for), stops `createdBy` being rewritten to steal or disown authorship,
      // and stops new fields being introduced outside the `hasOnly()` allowlist
      // that `create` enforces — an allowlist `update` would otherwise sail
      // straight past, since `isValidCustomQuestion()` only guards creates.
      //
      // Note the status is *not* required to differ. A no-op write is harmless,
      // and demanding a change would make an idempotent retry fail — the client
      // cannot always know whether the write that timed out actually landed.
      allow update: if isReviewer()
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['status'])
                    && request.resource.data.status in ['approved', 'pending', 'rejected'];

      // Deletion stays console-only. A reviewer can stop a question being
      // served; erasing it is a different power, and nothing yet needs it.
      allow delete: if false;
    }

    // The per-hour submission counter, and the only reason a question write is
    // ever refused for volume (`BACKLOG.md` item 3).
    //
    // Deliberately NOT folded into the question's own document ID, which is how
    // the session and report caps work. `getCustomQuestions()` samples the bank
    // by generating a random Firestore auto-ID and reading forward from it, so
    // it depends on question IDs being uniformly distributed across that
    // 62-character space. A `{window}-{uid}` ID begins with digits, which sort
    // before every auto-ID, so capped questions would cluster at the very start
    // of the keyspace: nearly unreachable by a forward scan and
    // over-represented on the wrap-around. The cap would have quietly skewed
    // which questions players see.
    match /custom_question_quota/{quotaId} {
      // Readable by its owner so a refused submission can be explained
      // honestly — "you have reached the limit" is a claim the client is only
      // allowed to make after checking (`CLAUDE.md` §4.4).
      allow read: if isRealAuthedUser() && quotaId.matches('.*-' + request.auth.uid + '$');

      // Only ever the current window, only ever the caller's own, and only
      // ever starting at 1.
      allow create: if isRealAuthedUser()
                    && isProUser()
                    && quotaId == questionQuotaWindow() + '-' + request.auth.uid
                    && request.resource.data.keys().hasOnly(['count'])
                    && request.resource.data.count is int
                    && request.resource.data.count == 1;

      // Strictly +1. Anything else — a decrement, a reset, a jump — is refused,
      // which is what stops the counter being walked back down.
      allow update: if isRealAuthedUser()
                    && isProUser()
                    && quotaId == questionQuotaWindow() + '-' + request.auth.uid
                    && request.resource.data.keys().hasOnly(['count'])
                    && request.resource.data.count is int
                    && request.resource.data.count == resource.data.count + 1
                    && request.resource.data.count <= maxQuestionsPerWindow();

      // Deleting one would reset the hour.
      allow delete: if false;
    }

    // A player's report about a community question (finding H4).
    function isValidQuestionReport() {
      let data = request.resource.data;
      return data.keys().hasOnly(['questionId', 'reason', 'detail', 'reportedBy', 'createdAt'])
            && data.questionId is string
            && data.questionId.size() > 0
            && data.questionId.size() <= 128
            // A report about a question that doesn't exist is pure noise in
            // the review queue. One billed read per create is a fair price on
            // a path this rare and this capped — contrast the checkout price
            // lookup, which rules *can't* do and the function must.
            && exists(/databases/$(database)/documents/custom_questions/$(data.questionId))
            && data.reason in ['incorrect', 'inappropriate', 'spam', 'other']
            && (!('detail' in data)
                || (data.detail is string && data.detail.size() > 0 && data.detail.size() <= 500))
            && data.reportedBy is string
            && data.reportedBy == request.auth.uid
            && isNearRequestTime(data.createdAt);
    }

    // Reports are deliberately open to ANY signed-in caller, anonymous
    // included: most players never sign in, and an abuse channel most of the
    // audience can't use is half a channel. What makes that safe is that a
    // report is inert — nothing reads it but the owner in the console, and
    // nothing triggers on it — and the document ID carries the same
    // {window}-{slot} volume cap as the session documents (A3), suffixed
    // with the caller's own uid so one user's slots can't occupy another's
    // in this shared top-level collection. The uid lands in the regex as a
    // literal: Firebase-minted uids are alphanumeric, and this app never
    // uses custom tokens, so there are no regex metacharacters to worry
    // about — and ownership doesn't ride on the ID anyway, `reportedBy` is
    // bound to the caller separately above.
    //
    // Review is console-only (the Admin SDK bypasses these rules), so every
    // client verb except create is denied — including read: a report may
    // quote another user's content and name its author, and no client has
    // any business enumerating those.
    match /question_reports/{reportId} {
      allow read: if false;
      allow create: if request.auth != null
                    && isValidQuestionReport()
                    && reportId.matches(
                         '^(' + sessionWindow(-300000)
                         + '|' + sessionWindow(0)
                         + '|' + sessionWindow(300000) + ')-[0-9]-'
                         + request.auth.uid + '$'
                       );
      allow update, delete: if false;
    }

    // Collections managed by our own Cloud Functions backend (`functions/`)
    // — this used to be the "Run Subscriptions with Stripe" Firebase
    // Extension, migrated off ahead of that product line's March 2027
    // shutdown. Those functions use the Admin SDK, which bypasses these
    // rules entirely — the rules below only constrain direct client access.
    match /customers/{uid} {
      // A user may read their own customer doc (Stripe customer ID) but
      // never write it directly — only `createCheckoutSession` does, via
      // Admin SDK, on first checkout.
      allow read: if isRealAuthedUser() && request.auth.uid == uid;

      match /checkout_sessions/{id} {
        // The client creates a session doc to kick off Checkout and reads
        // it back to learn the hosted checkout URL `createCheckoutSession`
        // writes in response; it never updates/deletes one directly.
        allow read: if isRealAuthedUser() && request.auth.uid == uid;
        allow create: if isRealAuthedUser()
                      && request.auth.uid == uid
                      && isValidCheckoutSession()
                      && isRateLimitedSessionId(id);
      }

      match /portal_sessions/{id} {
        // Same handshake as checkout_sessions above, but for opening
        // Stripe's hosted billing portal (`createPortalSession`).
        allow read: if isRealAuthedUser() && request.auth.uid == uid;
        allow create: if isRealAuthedUser()
                      && request.auth.uid == uid
                      && isValidPortalSession()
                      && isRateLimitedSessionId(id);
      }

      match /subscriptions/{id} {
        // Synced read-only from Stripe by `stripeWebhook`; drives the
        // real-time `isProUser` UI signal.
        allow read: if isRealAuthedUser() && request.auth.uid == uid;
      }
    }

    // Product/price catalog `stripeWebhook` mirrors from the Stripe
    // Dashboard — public so the pricing page and checkout-session creation
    // can read the current Pro price without any secrets.
    match /products/{id} {
      allow read: if true;

      match /prices/{id} {
        allow read: if true;
      }
    }

    // Leaderboard: readable by anyone; one document per user (doc ID == uid),
    // append-only in the sense that a write only succeeds if it beats that
    // user's existing best score.
    //
    // The pre-G7 board, now **retired**. Its contents were copied into
    // `leaderboards/15/entries` by `scripts/migrate-leaderboard-to-boards.mjs`
    // — every entry was won under the fixed 15-second limit — and the client
    // no longer reads or writes it.
    //
    // Writes are denied rather than left open. A client cached from before the
    // switch would otherwise keep writing scores into a collection nothing
    // reads, which looks like success and silently loses every entry; refused,
    // it shows "Could not save your score. Please try again", and a reload
    // fixes it. Same trade as the checkout-session schema change
    // (`data-model.md` §3).
    //
    // Reads stay open so the documents remain inspectable, and because the
    // migration is re-runnable: deleting nothing is what makes a mistake here
    // cost nothing.
    match /leaderboard/{uid} {
      allow read: if true;
      allow write: if false;
    }

    // One board per timing constraint (finding G7). Same contract as above —
    // public read, own-uid write, only an improving score — with the board in
    // the path.
    //
    // A subcollection rather than a `timeLimit` field on a flat collection,
    // deliberately: `where('timeLimit','==',x).orderBy('score','desc')` needs
    // a composite index, and index configuration is the one thing the
    // emulator cannot verify — a mistake in it took the deploy pipeline down
    // for four consecutive merges (D3, `data-model.md` §3). Per-board
    // `orderBy('score','desc').limit(10)` needs only the automatic
    // single-field index, so that whole class of risk does not arise.
    //
    // Note the read rule checks the board name too. Firestore would happily
    // serve a query against `leaderboards/anything/entries`, and an unchecked
    // path segment is a public collection whose name an attacker chooses.
    match /leaderboards/{limit}/entries/{uid} {
      allow read: if isValidBoard(limit);
      allow create: if isRealAuthedUser()
                    && request.auth.uid == uid
                    && isValidBoard(limit)
                    && isValidBoardEntry(uid, limit);
      allow update: if isRealAuthedUser()
                    && request.auth.uid == uid
                    && isValidBoard(limit)
                    && isValidBoardEntry(uid, limit)
                    && request.resource.data.score > resource.data.score;
      allow delete: if false;
    }
  }
}
