rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Signed in, not anonymous, and (for password accounts) email-verified —
    // so spinning up throwaway/alias accounts can't be used to flood the
    // leaderboard.
    function isRealAuthedUser() {
      return request.auth != null
             && request.auth.token.firebase.sign_in_provider != 'anonymous'
             && (request.auth.token.firebase.sign_in_provider != 'password'
                 || request.auth.token.email_verified == true);
    }

    // Set by our Stripe webhook handler (functions/src/subscriptions.ts) as
    // a custom claim on the user's ID token once a subscription with a
    // price tagged `firebaseRole: 'pro'` (see the Stripe Dashboard setup)
    // reaches `active`/`trialing`. This is what actually gates the write
    // below — the client's real-time `SubscriptionService.isProUser` signal
    // is read-your-own-writes UX only and carries no authority here.
    function isProUser() {
      return request.auth != null && request.auth.token.stripeRole == 'pro';
    }

    // Bounds on a client-supplied epoch-ms timestamp: it must sit close to
    // when the server actually saw the request. Generous on the past side for
    // a slow connection or a clock a few minutes behind, tight on the future
    // side. Without this, `createdAt` is decoration — a client can write any
    // number it likes, including one chosen to sort itself first.
    function isNearRequestTime(millis) {
      return millis is int
             && millis <= request.time.toMillis() + 60000
             && millis >= request.time.toMillis() - 300000;
    }

    // The longest game the app can produce. GameSetupComponent offers
    // 5/10/15/20/25 questions, so 25 is the ceiling a real game can reach.
    //
    // Deliberately NOT restricted to that exact set: a `custom` or `mixed`
    // game legitimately returns *fewer* questions than requested when the
    // bank doesn't have enough (TriviaService slices over whatever matched),
    // so asking for 25 when 7 exist produces a genuine 7-question game.
    // Allowing 1..25 accepts every real game and nothing longer.
    //
    // Raising the option list above 25 means raising this too — the rules
    // tests will fail loudly if the two ever disagree, which is the point.
    function isValidLeaderboardEntry(uid) {
      let data = request.resource.data;
      return data.keys().hasOnly(
                ['uid', 'name', 'score', 'totalQuestions', 'percentage', 'createdAt']
              )
            && data.uid == uid
            && data.name is string
            && data.name.size() > 0
            && data.name.size() <= 30
            && data.score is int
            && data.score >= 0
            && data.totalQuestions is int
            && data.totalQuestions >= 1
            && data.totalQuestions <= 25
            && data.totalQuestions >= data.score
            // Must agree with score/totalQuestions rather than being a free
            // 0..100 field — otherwise 1 correct out of 10 can be published as
            // 100%. Firestore's math.round() was verified to match
            // JavaScript's Math.round() on .5 boundaries, so exact equality is
            // safe here and no tolerance is needed.
            && data.percentage is int
            && data.percentage == math.round(data.score * 100.0 / data.totalQuestions)
            && isNearRequestTime(data.createdAt);
    }

    // A bare `scheme://host[:port]` — no path, no query, no fragment, so
    // there is nothing to smuggle into the redirect URL the Cloud Function
    // builds from it. Which origins are actually *ours* deliberately isn't
    // decided here: preview channels mint a new hostname per PR, and this
    // same file runs against the emulator on localhost, so the rules can only
    // bound the shape. The allowlist proper is in the function
    // (functions/src/checkout-request.ts) — this is the structural half of
    // the two-layer check, not the whole of it.
    function isAppOrigin(origin) {
      return origin is string
            && origin.size() <= 200
            && origin.matches(
                 '^https://[a-z0-9-]+([.][a-z0-9-]+)+(:[0-9]{1,5})?$'
                 + '|^http://(localhost|127[.]0[.]0[.]1)(:[0-9]{1,5})?$'
               );
    }

    // The only two things a checkout-session document may carry. Everything
    // else the Stripe call needs — the mode, and both redirect URLs — is
    // decided by `createCheckoutSession` itself, so there is no longer a
    // client-chosen value for it to hand to Stripe. `price` is bounded to the
    // shape of a Stripe price ID here; whether that ID is one we actually
    // sell is checked again in the function, against the mirrored catalog,
    // because rules cannot look a value up in a catalog.
    function isValidCheckoutSession() {
      let data = request.resource.data;
      return data.keys().hasOnly(['price', 'origin'])
            && data.price is string
            && data.price.matches('^price_[A-Za-z0-9_]{1,100}$')
            && isAppOrigin(data.origin);
    }

    function isValidPortalSession() {
      let data = request.resource.data;
      return data.keys().hasOnly(['origin'])
            && isAppOrigin(data.origin);
    }

    // The window a session document ID is bucketed into, as a string.
    // 300000ms = 5 minutes, chosen to match the past-side tolerance of
    // `isNearRequestTime()` above — that is the client-clock skew this app
    // has already decided to live with, and a client has to derive the same
    // bucket from its own clock to write one of these.
    //
    // Plain `/` and not `math.floor()`: dividing two ints in this language
    // already truncates (and epoch millis are always positive, so truncation
    // and floor agree), whereas `math.floor()` returns a *float*, which
    // `string()` then renders as "5954006.0" and no client would ever match.
    // Verified against the emulator rather than assumed, the same way
    // `math.round()` was checked before the leaderboard relied on it.
    function sessionWindow(offsetMillis) {
      return string((request.time.toMillis() + offsetMillis) / 300000);
    }

    // The volume cap. Rules cannot count a user's documents, but they can
    // constrain the document ID, and `create` only ever applies to an ID that
    // doesn't exist yet — so restricting the ID to `{window}-{slot 0-9}`
    // means each of those ten IDs can be used exactly once per window. That
    // is ten Cloud Function invocations, and therefore ten Stripe API calls,
    // per five minutes per user; without it a loop of `addDoc` calls spends
    // the Functions quota and the Stripe rate limit as fast as it can write.
    //
    // The neighbouring windows are accepted too, so a clock a few minutes off
    // — or a write that simply crosses a boundary between the client picking
    // an ID and the server evaluating it — isn't rejected. That widens a
    // burst to thirty, but the steady-state rate is still ten per window.
    function isRateLimitedSessionId(sessionId) {
      return sessionId.matches(
        '^(' + sessionWindow(-300000)
        + '|' + sessionWindow(0)
        + '|' + sessionWindow(300000) + ')-[0-9]$'
      );
    }

    function isValidCustomQuestion() {
      let data = request.resource.data;
      return data.keys().hasOnly(
                ['category', 'type', 'difficulty', 'question', 'correct_answer',
                 'incorrect_answers', 'createdBy', 'createdAt']
              )
            && data.category is string && data.category.size() > 0 && data.category.size() <= 100
            && data.type in ['multiple', 'boolean']
            && data.difficulty in ['easy', 'medium', 'hard']
            && data.question is string && data.question.size() > 0 && data.question.size() <= 500
            && data.correct_answer is string
            && data.correct_answer.size() > 0 && data.correct_answer.size() <= 200
            && data.incorrect_answers is list
            // 3, not 5: AddQuestionComponent offers exactly three incorrect
            // fields for a multiple-choice question and derives one for a
            // boolean, so 1..3 is every question the app can actually produce.
            // The old ceiling of 5 allowed six answers in total while the quiz
            // only ever labelled four (finding B2).
            && data.incorrect_answers.size() >= 1 && data.incorrect_answers.size() <= 3
            // An answer that is both correct and incorrect is not a question,
            // it is a scoring bug waiting to happen: the quiz used to match a
            // click against `correct_answer` by text, so the wrong option
            // scored as correct (finding B1). The client no longer compares by
            // text, but the data should never have contained the ambiguity in
            // the first place — fixing only the reader would leave the next
            // reader to rediscover it.
            && !(data.correct_answer in data.incorrect_answers)
            && data.incorrect_answers.toSet().size() == data.incorrect_answers.size()
            // Attribution is mandatory and self-asserting only: a submitter
            // can name themselves and nobody else. This is what makes an abuse
            // report actionable, and what lets account deletion find a user's
            // contributions — neither is retrofittable, because no backfill
            // can invent an author for a document that never recorded one.
            && data.createdBy is string && data.createdBy == request.auth.uid
            && isNearRequestTime(data.createdAt);
    }

    // Question bank: readable by anyone playing the game. Creating a new
    // question requires both the anti-flood gate (real, non-anonymous,
    // verified-if-password account) and an active Pro subscription — this
    // is a paid-tier feature, see PricingComponent/AddQuestionComponent —
    // subject to schema validation above; editing/removing an existing one
    // is console-only.
    match /custom_questions/{questionId} {
      allow read: if true;
      allow create: if isRealAuthedUser() && isProUser() && isValidCustomQuestion();
      allow update, delete: if false;
    }

    // A player's report about a community question (finding H4).
    function isValidQuestionReport() {
      let data = request.resource.data;
      return data.keys().hasOnly(['questionId', 'reason', 'detail', 'reportedBy', 'createdAt'])
            && data.questionId is string
            && data.questionId.size() > 0
            && data.questionId.size() <= 128
            // A report about a question that doesn't exist is pure noise in
            // the review queue. One billed read per create is a fair price on
            // a path this rare and this capped — contrast the checkout price
            // lookup, which rules *can't* do and the function must.
            && exists(/databases/$(database)/documents/custom_questions/$(data.questionId))
            && data.reason in ['incorrect', 'inappropriate', 'spam', 'other']
            && (!('detail' in data)
                || (data.detail is string && data.detail.size() > 0 && data.detail.size() <= 500))
            && data.reportedBy is string
            && data.reportedBy == request.auth.uid
            && isNearRequestTime(data.createdAt);
    }

    // Reports are deliberately open to ANY signed-in caller, anonymous
    // included: most players never sign in, and an abuse channel most of the
    // audience can't use is half a channel. What makes that safe is that a
    // report is inert — nothing reads it but the owner in the console, and
    // nothing triggers on it — and the document ID carries the same
    // {window}-{slot} volume cap as the session documents (A3), suffixed
    // with the caller's own uid so one user's slots can't occupy another's
    // in this shared top-level collection. The uid lands in the regex as a
    // literal: Firebase-minted uids are alphanumeric, and this app never
    // uses custom tokens, so there are no regex metacharacters to worry
    // about — and ownership doesn't ride on the ID anyway, `reportedBy` is
    // bound to the caller separately above.
    //
    // Review is console-only (the Admin SDK bypasses these rules), so every
    // client verb except create is denied — including read: a report may
    // quote another user's content and name its author, and no client has
    // any business enumerating those.
    match /question_reports/{reportId} {
      allow read: if false;
      allow create: if request.auth != null
                    && isValidQuestionReport()
                    && reportId.matches(
                         '^(' + sessionWindow(-300000)
                         + '|' + sessionWindow(0)
                         + '|' + sessionWindow(300000) + ')-[0-9]-'
                         + request.auth.uid + '$'
                       );
      allow update, delete: if false;
    }

    // Collections managed by our own Cloud Functions backend (`functions/`)
    // — this used to be the "Run Subscriptions with Stripe" Firebase
    // Extension, migrated off ahead of that product line's March 2027
    // shutdown. Those functions use the Admin SDK, which bypasses these
    // rules entirely — the rules below only constrain direct client access.
    match /customers/{uid} {
      // A user may read their own customer doc (Stripe customer ID) but
      // never write it directly — only `createCheckoutSession` does, via
      // Admin SDK, on first checkout.
      allow read: if isRealAuthedUser() && request.auth.uid == uid;

      match /checkout_sessions/{id} {
        // The client creates a session doc to kick off Checkout and reads
        // it back to learn the hosted checkout URL `createCheckoutSession`
        // writes in response; it never updates/deletes one directly.
        allow read: if isRealAuthedUser() && request.auth.uid == uid;
        allow create: if isRealAuthedUser()
                      && request.auth.uid == uid
                      && isValidCheckoutSession()
                      && isRateLimitedSessionId(id);
      }

      match /portal_sessions/{id} {
        // Same handshake as checkout_sessions above, but for opening
        // Stripe's hosted billing portal (`createPortalSession`).
        allow read: if isRealAuthedUser() && request.auth.uid == uid;
        allow create: if isRealAuthedUser()
                      && request.auth.uid == uid
                      && isValidPortalSession()
                      && isRateLimitedSessionId(id);
      }

      match /subscriptions/{id} {
        // Synced read-only from Stripe by `stripeWebhook`; drives the
        // real-time `isProUser` UI signal.
        allow read: if isRealAuthedUser() && request.auth.uid == uid;
      }
    }

    // Product/price catalog `stripeWebhook` mirrors from the Stripe
    // Dashboard — public so the pricing page and checkout-session creation
    // can read the current Pro price without any secrets.
    match /products/{id} {
      allow read: if true;

      match /prices/{id} {
        allow read: if true;
      }
    }

    // Leaderboard: readable by anyone; one document per user (doc ID == uid),
    // append-only in the sense that a write only succeeds if it beats that
    // user's existing best score.
    match /leaderboard/{uid} {
      allow read: if true;
      allow create: if isRealAuthedUser()
                    && request.auth.uid == uid
                    && isValidLeaderboardEntry(uid);
      allow update: if isRealAuthedUser()
                    && request.auth.uid == uid
                    && isValidLeaderboardEntry(uid)
                    && request.resource.data.score > resource.data.score;
      allow delete: if false;
    }
  }
}
