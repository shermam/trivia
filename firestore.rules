rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Signed in, not anonymous, and (for password accounts) email-verified —
    // so spinning up throwaway/alias accounts can't be used to flood the
    // leaderboard.
    function isRealAuthedUser() {
      return request.auth != null
             && request.auth.token.firebase.sign_in_provider != 'anonymous'
             && (request.auth.token.firebase.sign_in_provider != 'password'
                 || request.auth.token.email_verified == true);
    }

    // Set by our Stripe webhook handler (functions/src/subscriptions.ts) as
    // a custom claim on the user's ID token once a subscription with a
    // price tagged `firebaseRole: 'pro'` (see the Stripe Dashboard setup)
    // reaches `active`/`trialing`. This is what actually gates the write
    // below — the client's real-time `SubscriptionService.isProUser` signal
    // is read-your-own-writes UX only and carries no authority here.
    function isProUser() {
      return request.auth != null && request.auth.token.stripeRole == 'pro';
    }

    function isValidLeaderboardEntry(uid) {
      return request.resource.data.keys().hasOnly(
                ['uid', 'name', 'score', 'totalQuestions', 'percentage', 'createdAt']
              )
            && request.resource.data.uid == uid
            && request.resource.data.name is string
            && request.resource.data.name.size() > 0
            && request.resource.data.name.size() <= 30
            && request.resource.data.score is int
            && request.resource.data.score >= 0
            && request.resource.data.totalQuestions is int
            && request.resource.data.totalQuestions >= request.resource.data.score
            && request.resource.data.percentage is number
            && request.resource.data.percentage >= 0
            && request.resource.data.percentage <= 100
            && request.resource.data.createdAt is int;
    }

    // Bounds on a client-supplied epoch-ms timestamp: it must sit close to
    // when the server actually saw the request. Generous on the past side for
    // a slow connection or a clock a few minutes behind, tight on the future
    // side. Without this, `createdAt` is decoration — a client can write any
    // number it likes, including one chosen to sort itself first.
    function isNearRequestTime(millis) {
      return millis is int
             && millis <= request.time.toMillis() + 60000
             && millis >= request.time.toMillis() - 300000;
    }

    function isValidCustomQuestion() {
      let data = request.resource.data;
      return data.keys().hasOnly(
                ['category', 'type', 'difficulty', 'question', 'correct_answer',
                 'incorrect_answers', 'createdBy', 'createdAt']
              )
            && data.category is string && data.category.size() > 0 && data.category.size() <= 100
            && data.type in ['multiple', 'boolean']
            && data.difficulty in ['easy', 'medium', 'hard']
            && data.question is string && data.question.size() > 0 && data.question.size() <= 500
            && data.correct_answer is string
            && data.correct_answer.size() > 0 && data.correct_answer.size() <= 200
            && data.incorrect_answers is list
            && data.incorrect_answers.size() >= 1 && data.incorrect_answers.size() <= 5
            // Attribution is mandatory and self-asserting only: a submitter
            // can name themselves and nobody else. This is what makes an abuse
            // report actionable, and what lets account deletion find a user's
            // contributions — neither is retrofittable, because no backfill
            // can invent an author for a document that never recorded one.
            && data.createdBy is string && data.createdBy == request.auth.uid
            && isNearRequestTime(data.createdAt);
    }

    // Question bank: readable by anyone playing the game. Creating a new
    // question requires both the anti-flood gate (real, non-anonymous,
    // verified-if-password account) and an active Pro subscription — this
    // is a paid-tier feature, see PricingComponent/AddQuestionComponent —
    // subject to schema validation above; editing/removing an existing one
    // is console-only.
    match /custom_questions/{questionId} {
      allow read: if true;
      allow create: if isRealAuthedUser() && isProUser() && isValidCustomQuestion();
      allow update, delete: if false;
    }

    // Collections managed by our own Cloud Functions backend (`functions/`)
    // — this used to be the "Run Subscriptions with Stripe" Firebase
    // Extension, migrated off ahead of that product line's March 2027
    // shutdown. Those functions use the Admin SDK, which bypasses these
    // rules entirely — the rules below only constrain direct client access.
    match /customers/{uid} {
      // A user may read their own customer doc (Stripe customer ID) but
      // never write it directly — only `createCheckoutSession` does, via
      // Admin SDK, on first checkout.
      allow read: if isRealAuthedUser() && request.auth.uid == uid;

      match /checkout_sessions/{id} {
        // The client creates a session doc to kick off Checkout and reads
        // it back to learn the hosted checkout URL `createCheckoutSession`
        // writes in response; it never updates/deletes one directly.
        allow read, create: if isRealAuthedUser() && request.auth.uid == uid;
      }

      match /portal_sessions/{id} {
        // Same handshake as checkout_sessions above, but for opening
        // Stripe's hosted billing portal (`createPortalSession`).
        allow read, create: if isRealAuthedUser() && request.auth.uid == uid;
      }

      match /subscriptions/{id} {
        // Synced read-only from Stripe by `stripeWebhook`; drives the
        // real-time `isProUser` UI signal.
        allow read: if isRealAuthedUser() && request.auth.uid == uid;
      }
    }

    // Product/price catalog `stripeWebhook` mirrors from the Stripe
    // Dashboard — public so the pricing page and checkout-session creation
    // can read the current Pro price without any secrets.
    match /products/{id} {
      allow read: if true;

      match /prices/{id} {
        allow read: if true;
      }
    }

    // Leaderboard: readable by anyone; one document per user (doc ID == uid),
    // append-only in the sense that a write only succeeds if it beats that
    // user's existing best score.
    match /leaderboard/{uid} {
      allow read: if true;
      allow create: if isRealAuthedUser()
                    && request.auth.uid == uid
                    && isValidLeaderboardEntry(uid);
      allow update: if isRealAuthedUser()
                    && request.auth.uid == uid
                    && isValidLeaderboardEntry(uid)
                    && request.resource.data.score > resource.data.score;
      allow delete: if false;
    }
  }
}
