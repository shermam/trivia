# Compiled output
/lib

# Dependencies
/node_modules

# Local-only Firebase Functions v2 config — these can hold secret values for
# a developer's own local `firebase emulators:start` and must never be
# committed (unlike the project-scoped `.env.<project-id>` files below).
.env
.env.local
.secret.local

# `.env.demo-trivia-app-e2e` IS committed on purpose: it only sets
# STRIPE_MOCK_CHECKOUT=true for the throwaway e2e project so Cypress/CI never
# need real Stripe credentials — see src/stripe-client.ts. The root
# .gitignore's blanket `.env.*` rule would otherwise catch this file too.
!.env.demo-trivia-app-e2e

# `.secret.local` used to be committed (as the emulator's placeholder
# fallback for `defineSecret()` values) and no longer is — a tracked file
# whose name promises "personal, gitignored" is one careless `git commit -am`
# away from publishing a real Stripe key. The committed placeholders now live
# in `.secret.local.example`, and the root `postinstall`
# (scripts/ensure-functions-secret-local.mjs) copies them into place when
# `.secret.local` is missing. Real test-mode keys go in `.secret.local`
# itself, where this file guarantees they can't be committed.
